<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../TargetFrameworks.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Shooting</RootNamespace>
    <AssemblyName>THSSS</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS8981;CS0169;CS0414;CS0649;CS0108;CS0618;CS0612;CS0114;SYSLIB0011</NoWarn>
  </PropertyGroup>
  <PropertyGroup Label="Optional">
    <DefineConstants Condition="'$(THSSSManagedDesFallback)' == 'true'">$(DefineConstants);THSSS_MANAGED_DES_FALLBACK</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Label="Platform sources">
    <THSSSBuildRid>$(RuntimeIdentifier)</THSSSBuildRid>
    <THSSSBuildRid Condition="'$(THSSSBuildRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</THSSSBuildRid>
    <THSSSIsMacOS>$([System.String]::Copy('$(THSSSBuildRid)').StartsWith('osx-'))</THSSSIsMacOS>
    <DefineConstants Condition="'$(THSSSIsMacOS)' == 'true'">$(DefineConstants);THSSS_MACOS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('$(THSSSBuildRid)').StartsWith('win-'))">$(DefineConstants);THSSS_WINDOWS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(THSSSIsMacOS)' != 'true'">
    <Compile Remove="Platform/Graphics/Metal/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Config/**/*.cs" />
    <None Remove="Config/**" />
    <EmbeddedResource Remove="Config/**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Shooting/RenderForm_Main.resx"><LogicalName>Shooting.RenderForm_Main.resources</LogicalName></EmbeddedResource>
    <EmbeddedResource Update="Shooting/Properties/Resources.resx"><LogicalName>Shooting.Properties.Resources.resources</LogicalName></EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.7" />
    <PackageReference Include="ini-parser" Version="2.5.2" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.5" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.13" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../game/FX/**/*" Link="FX/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../game/Model/**/*" Link="Model/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../game/Image/**/*" Link="Image/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../game/BGM/**/*" Link="BGM/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../game/Sound/**/*" Link="Sound/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../game/Story/**/*" Link="Story/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../game/CS/**/*" Link="CS/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../game/BPic/**/*" Link="BPic/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../game/Setting.INI" Link="Setting.INI" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VulkanBackend" />
    <InternalsVisibleTo Include="MetalShaderExporter" />
  </ItemGroup>
</Project>
