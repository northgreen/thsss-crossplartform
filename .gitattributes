reference/original/*.exe filter=lfs diff=lfs merge=lfs -text
reference/original/*.dll filter=lfs diff=lfs merge=lfs -text
# Keep these unchanged reference binaries in ordinary Git, as in existing history.
reference/original/SlimDX.dll -filter -diff -merge -text
reference/original/THSSS.exe -filter -diff -merge -text
game/**/*.wav filter=lfs diff=lfs merge=lfs -text
game/**/*.png filter=lfs diff=lfs merge=lfs -text
game/**/*.bmp filter=lfs diff=lfs merge=lfs -text
game/**/*.x filter=lfs diff=lfs merge=lfs -text
game/**/*.rpy filter=lfs diff=lfs merge=lfs -text
*.sh text eol=lf
*.command text eol=lf
*.pl text eol=lf
# Frozen vendor sources and licenses are verified byte-for-byte by build.py.
# Never rewrite their line endings during Windows checkout or Git add.
native/LegacyMath/vendor/** -text
# NuGet license hashes must also survive Windows autocrlf checkout unchanged.
third_party/SkiaSharp/** -text
# Upstream notices retain their original CRLF and trailing spaces verbatim.
third_party/SkiaSharp/**/LICENSE.txt -whitespace
third_party/SkiaSharp/**/THIRD-PARTY-NOTICES.txt -whitespace
