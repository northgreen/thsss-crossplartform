# Behaviour suites. Process, timeout and exit code come from the shared driver in
# ../lib; every numeric assertion stays in the C# fixture it belongs to.
load_lib thsss.exp

set root [thsss_root]

# A suite must print its own PASS marker. A zero exit code alone is not enough: a
# fixture that dies before printing would otherwise look like a pass.
#
# Budgets differ because the fixtures differ in kind: unit fixtures finish in seconds,
# while the windowed ones start real game processes. A budget that is too small is not
# a passing test - it is an unfinished one.
thsss_run ListCompatibility           [thsss_dotnet_run ListCompatibility]           {PASS: [0-9]+ legacy enumeration} 0 45
thsss_run AudioCompatibility          [thsss_dotnet_run AudioCompatibility]          {PASS AudioCompatibility}         0 90
thsss_run AudioBackendCompatibility   [thsss_dotnet_run AudioBackendCompatibility]   {PASS AudioBackendCompatibility}  0 90
thsss_run ManagedDesCheck             [thsss_dotnet_run ManagedDesCheck]             {PASS ManagedDesCheck}            0 45
thsss_run SaveCompatibility           [thsss_dotnet_run SaveCompatibility]           {PASS SaveCompatibility}          0 90
thsss_run TextScreenshotCompatibility [thsss_dotnet_run TextScreenshotCompatibility] {PASS text: Chinese measurement}  0 90
# This one launches two complete game processes (both keyboard modes, F8 cycle and a
# real quit), so it needs several minutes on a loaded machine.
thsss_run WindowInputCompatibility    [thsss_dotnet_run WindowInputCompatibility --glfw --game-smoke] {PASS WindowInputCompatibility} 0 300
thsss_run ConfigCompatibility         [thsss_dotnet_run ConfigCompatibility]         {PASS ConfigCompatibility}        0 45
thsss_run BuildWarningCompatibility   [thsss_dotnet_run BuildWarningCompatibility]   {PASS BuildWarningCompatibility}  0 45
thsss_run SkiaCompatibility           [thsss_dotnet_run SkiaCompatibility]           {PASS SkiaCompatibility}          0 90

# The resize fixture needs an isolated data root and runs once per renderer, so the
# player's own save files are never touched. It drives the real game loop, which needs
# a much larger budget than the unit fixtures.
proc resize_run {renderer} {
    set data [thsss_prepare_data "resize-$renderer"]
    set env(THSSS_RENDERER) $renderer
    thsss_run "WindowResizeCompatibility ($renderer)" \
        [thsss_dotnet_run WindowResizeCompatibility $data] \
        {PASS resize/minimize/fullscreen} 0 180
    catch {file delete -force $data}
}
resize_run gl
resize_run vk
