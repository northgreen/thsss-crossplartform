# Software API drivers that exercise the real managed native-call paths on Linux.
# The driver never executes MSL or Apple audio; it validates the call contract.
load_lib thsss.exp

if {![info exists env(THSSS_MAC_CONTRACT_DIR)]} {
    error "Use tools/run-mac-regressions.sh to build the API drivers."
}
set root [thsss_root]
set output $env(THSSS_MAC_CONTRACT_DIR)

# These fixtures are already built by the runner, so the committed DLLs are used
# directly rather than going through `dotnet run` and rebuilding per case.
proc built {suite args} {
    global root env
    set command [list dotnet [file join $root tests testcase $suite bin Debug $env(THSSS_FRAMEWORK) $suite.dll]]
    if {[llength $args] > 0} { lappend command {*}$args }
    return $command
}

thsss_run "AudioQueue native ABI and queue software contract" \
    [built CoreAudioCompatibility [file join $output libaudioqueue.so]] \
    {PASS CoreAudioCompatibility:} 0 120
thsss_run "Metal native selectors, command recording and resource software contract" \
    [built MetalApiCompatibility] \
    {PASS: [0-9]+ assertions; actual Metal backend P/Invoke} 0 120
thsss_run "Real GLSL SPIR-V MSL translation" \
    [built MetalCompatibility] \
    {PASS MetalCompatibility:} 0 120
